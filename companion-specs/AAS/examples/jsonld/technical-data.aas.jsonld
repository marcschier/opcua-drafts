      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "https://admin-shell.io/DataSpecificationTemplates/DataSpecificationIEC61360/3/0"
    },
    {
      "@id": "_:b1286",
      "@type": "aas:DataSpecificationIec61360",
      "dataType": "aas:DataTypeIec61360/String",
      "definition": "_:b1289",
      "preferredName": "_:b1287"
    },
    {
      "@id": "_:b1287",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "reference test for 'Expected lifetime: Number of charge-discharge cycles'"
    },
    {
      "@id": "_:b1289",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "The battery passport must include information about the expected battery lifetime expressed in cycles, and reference test used. \n\nDIN DKE Spec 99100 chapter reference: 6.7.6.5"
    },
    {
      "@id": "_:b129",
      "@type": "aas:Reference",
