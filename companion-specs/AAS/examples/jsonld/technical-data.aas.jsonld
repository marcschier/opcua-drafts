      "supplementalSemanticIds": [
        "_:b129",
        "_:b133"
      ],
      "typeValueListElement": "aas:AasSubmodelElements/File"
    },
    {
      "@id": "_:b1231",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b1232"
    },
    {
      "@id": "_:b1232",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "urn:samm:org.eclipse.esmf.samm:unit:2.1.0#cycle"
    },
    {
      "@id": "_:b1234",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "Expected battery lifetime expressed in cycles.\nThe exception for non-cycle applications in Article 10 appears sensible, but is not included in the Annex XIII provision.\nThe data attribute is defined by measurement conditions of the cycle-life test such as the C-Rate (see below) and the depth of discharge in the cycle-life test\n\nDIN DKE Spec 99100 chapter reference: 6.7.6.3"
    },
    {
      "@id": "_:b1237",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "power capability ratio"
    },
    {
      "@id": "_:b1239",
      "@type": "aas:EmbeddedDataSpecification",
      "dataSpecification": "_:b1240",
      "dataSpecificationContent": "_:b1243"
    },
    {
      "@id": "_:b124",
      "@type": "aas:LangStringTextType",
      "language": "en",
      "text": "List for image file(s) for associated product provided in common format (.png, .jpg)."
    },
    {
      "@id": "_:b1240",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b1241"
    },
    {
      "@id": "_:b1241",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "https://admin-shell.io/DataSpecificationTemplates/DataSpecificationIEC61360/3/0"
    },
    {
      "@id": "_:b1243",
      "@type": "aas:DataSpecificationIec61360",
      "dataType": "aas:DataTypeIec61360/RealMeasure",
      "definition": "_:b1249",
