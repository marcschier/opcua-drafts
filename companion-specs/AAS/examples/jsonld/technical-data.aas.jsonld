      },
      "aas:Key/value": "urn:samm:org.eclipse.esmf.samm:unit:2.1.0#percent"
    },
    {
      "@id": "_:b1202",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "Power capability shall be measured at reference conditions, which must include measurements at 80% and 20% state of charge for EV and industrial batteries."
    },
    {
      "@id": "_:b1205",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "expected lifetime"
    },
    {
      "@id": "_:b1207",
