      "language": "en",
      "text": "generalInformation"
    },
    {
      "@id": "_:b1263",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "General information, for example ordering and manufacturer information."
    },
    {
      "@id": "_:b1266",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "c rate life cycle test"
    },
    {
