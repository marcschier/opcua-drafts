      "unitId": "_:b1246"
    },
    {
      "@id": "_:b1244",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "power capability ratio"
    },
    {
      "@id": "_:b1246",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b1247"
    },
    {
      "@id": "_:b1247",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "urn:samm:org.eclipse.esmf.samm:unit:2.1.0#percent"
    },
    {
      "@id": "_:b1249",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "The nominal battery power is the suitable approximate value of the power capability used to designate or identify the battery, while the battery energy is determined in reference conditions to be defined.\n   \n   DIN DKE Spec 99100 chapter reference: 6.7.3.6\n   "
    },
    {
      "@id": "_:b1252",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "general information"
    },
    {
      "@id": "_:b1254",
      "@type": "aas:EmbeddedDataSpecification",
      "dataSpecification": "_:b1255",
      "dataSpecificationContent": "_:b1258"
    },
    {
