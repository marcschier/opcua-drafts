    {
      "@id": "_:b561",
      "@type": "aas:DataSpecificationIec61360",
      "dataType": "aas:DataTypeIec61360/RealMeasure",
      "definition": "_:b566",
      "preferredName": "_:b562",
      "shortName": "_:b564",
      "unit": "percent"
    },
    {
      "@id": "_:b562",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "renewable content"
    },
    {
      "@id": "_:b564",
      "@type": "aas:LangStringShortNameTypeIec61360",
      "language": "en",
      "text": "renewableContent"
    },
    {
      "@id": "_:b566",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "Share of renewable material content. A renewable material is a material made of natural resources that can be replenished. \n\nDIN DKE Spec 99100 chapter reference: 6.6.2.11"
    },
    {
      "@id": "_:b569",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "dismantling and removal information"
    },
    {
      "@id": "_:b57",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
