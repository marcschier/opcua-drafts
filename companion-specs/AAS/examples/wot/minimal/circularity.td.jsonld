      "language": "en",
      "text": "safety instructions"
    },
    {
      "@id": "_:b93",
      "@type": "aas:LangStringNameType",
      "language": "de",
      "text": "Länderkürzel"
    },
    {
      "@id": "_:b931",
      "@type": "aas:LangStringShortNameTypeIec61360",
      "language": "en",
      "text": "safetyInstructions"
    },
    {
      "@id": "_:b933",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "Necessary safety instructions to handle waste batteries, including in relation to the risks associated with, and the handling of, batteries containing lithium."
    },
    {
      "@id": "_:b936",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "extinguishing agents"
    },
