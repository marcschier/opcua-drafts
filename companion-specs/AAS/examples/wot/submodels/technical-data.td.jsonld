        "aas:Referable/description": [
          {
            "@type": "aas:LangStringTextType",
            "aas:AbstractLangString/language": "en",
            "aas:AbstractLangString/text": "A battery passport must include the battery category.\n\nThe battery category must be provided on the battery label.\n\nThe battery must be categorised by its intended use in (string values):\n- \"lmt\"\n- \"ev\" \n- \"industrial\", or\n- \"stationary\"\n\nDIN DKE Spec 99100 chapter reference: 6.1.3.5\n\n"
          }
        ],
        "aas:HasSemantics/semanticId": {
