  "aas:Referable/description": [
    {
      "@id": "_:aas-node-3",
      "@type": "aas:LangStringTextType",
      "aas:AbstractLangString/language": {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "en"
      },
      "aas:AbstractLangString/text": {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "interpreted as minimum percentage of rated capacity, above which the battery is still considered operational as EV battery in its current life. The value has to be provided by the economic operator. This metric may serve as indicator for a necessary end of current life as EV and may be understood in the context of warranty.\n\nDIN DKE Spec 99100 chapter reference:  6.7.6.9"
      }
    }
  ],
