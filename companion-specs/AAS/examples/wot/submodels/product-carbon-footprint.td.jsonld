          },
          {
            "@type": "aas:LangStringNameType",
            "aas:AbstractLangString/language": "en",
            "aas:AbstractLangString/text": "life cycle phases"
          }
        ],
        "aas:Referable/description": [
          {
            "@type": "aas:LangStringTextType",
            "aas:AbstractLangString/language": "en",
            "aas:AbstractLangString/text": "List of life cycle stages of the product according to the quantification requirements of the standard to which the PCF carbon footprint statement refers.\n\nThe string value in the value list is based on DIN DKE SPEC 99100: \"A1 - raw material supply (and upstream production)\" (6.3.5 required lify cycle mapping), \"A3 - production\" (6.3.4 Contribution of main product production/manufacturing lifecycle stage), \"A4 - transport to final destination\" (6.3.5 Contribution of distribution lifecycle stage), \"C3 - recycling, waste treatment\" (6.3.6 Contribution of end of life and recycling lifecycle stage)\n\nPlease note that the model should always contain at least one Product Carbon Footprint entry that reflects the total PCF value (including all life cycle phases) of the battery.\n"
          }
        ],
