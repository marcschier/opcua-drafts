# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Local validation aids (base NodeId tables, not distributed)
**/tools/ref/

# Scratch area used by the specification release workflow. The private-repository
# checkout is staged here; the workflow also excludes it by pathspec when staging
# the public commit, and this rule is the second, independent barrier against
# committing a private checkout into this public repository.
node_modules/

# The specification publisher's scratch output. `build` writes the STS and the NodeIds CSV
# here and `publish` the HTML and Word editions, so nothing in it is a source and nothing in
# it is reviewed; the committed artifacts are written to artifacts/ with an explicit --out.
_work/
