    },
    {
      "@id": "_:b576",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "where applicable, additional information on the marking in plain text, e.g. the ID-number of the notified body involved in the conformity process"
    },
