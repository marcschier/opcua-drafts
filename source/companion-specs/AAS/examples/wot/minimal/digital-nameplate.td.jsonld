    },
    {
      "@id": "_:b628",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "EU declaration of conformity"
    },
    {
      "@id": "_:b63",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b64"
    },
    {
      "@id": "_:b630",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "A battery passport must include the EU declaration of conformity.\n\n  DIN DKE Spec 99100 chapter reference: 6.2.7 \n\n Document identifiers (e.g., depending of different languages) of a document (e.g., PDF) that can be found in the Handover Documentation model."
    },
    {
      "@id": "_:b633",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "results of test reports proving compliance"
    },
    {
      "@id": "_:b635",
      "@type": "aas:EmbeddedDataSpecification",
      "dataSpecification": "_:b636",
      "dataSpecificationContent": "_:b639"
    },
    {
      "@id": "_:b636",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b637"
    },
    {
      "@id": "_:b637",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "https://admin-shell.io/DataSpecificationTemplates/DataSpecificationIec61360/3/0"
    },
    {
      "@id": "_:b639",
      "@type": "aas:DataSpecificationIec61360",
      "dataType": "aas:DataTypeIec61360/String",
      "definition": "_:b642",
      "preferredName": "_:b640"
    },
    {
      "@id": "_:b64",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "https://admin-shell.io/SubmodelTemplates/Cardinality/1/0"
    },
    {
      "@id": "_:b640",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "result of test reports proving compliance"
    },
    {
      "@id": "_:b642",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "A battery passport must include the test report results that can prove the compliance with the requirements stated in the battery regulation.\n\n  DIN DKE Spec 99100 chapter reference: 6.2.8\n\n Document identifiers (e.g., depending of different languages) of a document (e.g., PDF) that can be found in the Handover Documentation model.\n\n "
    },
    {
      "@id": "_:b645",
      "@type": "aas:LangStringNameType",
      "language": "en",
      "text": "battery status"
    },
    {
      "@id": "_:b647",
      "@type": "aas:EmbeddedDataSpecification",
      "dataSpecification": "_:b648",
      "dataSpecificationContent": "_:b651"
    },
    {
      "@id": "_:b648",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b649"
    },
    {
      "@id": "_:b649",
      "@type": "aas:Key",
      "aas:Key/type": {
        "@id": "aas:KeyTypes/GlobalReference"
      },
      "aas:Key/value": "https://admin-shell.io/DataSpecificationTemplates/DataSpecificationIec61360/3/0"
    },
    {
      "@id": "_:b651",
      "@type": "aas:DataSpecificationIec61360",
      "dataType": "aas:DataTypeIec61360/String",
      "definition": "_:b656",
      "preferredName": "_:b652",
      "shortName": "_:b654",
      "valueList": "_:b658"
    },
    {
      "@id": "_:b652",
      "@type": "aas:LangStringPreferredNameTypeIec61360",
      "language": "en",
      "text": "BatteryStatus"
    },
    {
      "@id": "_:b654",
      "@type": "aas:LangStringShortNameTypeIec61360",
      "language": "en",
      "text": "batteryStatus"
    },
    {
      "@id": "_:b656",
      "@type": "aas:LangStringDefinitionTypeIec61360",
      "language": "en",
      "text": "A battery passport must include information on the life cycle status of the battery.\n   \n   The status of the battery must be defined as 'original' (0173-1#07-ACC020#001), 'repurposed'(0173-1#07-ACC021#001), 're-used'(0173-1#07-ACC022#001), 'remanufactured' (0173-1#07-ACC023#001) or 'waste' (0173-1#07-ACC024#001).\n   \n   A new battery passport must be issued when a battery was subject to remanufacturing, repurpose or one of the treatment operations preparing for re-use and preparing for repurpose and is placed on the market again.\n   \n   DIN DKE Spec 99100 chapter reference: 6.1.3.7"
    },
    {
      "@id": "_:b658",
      "@type": "aas:ValueList",
      "valueReferencePairs": [
        "_:b659",
        "_:b664",
        "_:b669",
        "_:b674",
        "_:b679"
      ]
    },
    {
