      "@type": "aas:ValueReferencePair",
      "aas:ValueReferencePair/value": "original",
      "aas:ValueReferencePair/valueId": {
        "@id": "_:b660"
      }
    },
    {
      "@id": "_:b660",
      "@type": "aas:Reference",
      "aas:Reference/type": {
        "@id": "aas:ReferenceTypes/ExternalReference"
      },
      "keys": "_:b661"
    },
