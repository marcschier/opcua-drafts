  "templateDeviations": [
    {
      "id": "no-information-model",
      "clause": "7 to 13, Annex A",
      "statement": "This document defines a DataEncoding: a mapping of the OPC UA type model onto Apache Arrow, a PubSub batch mapping and a historian access surface. It defines no OPC UA information model of its own: it has no NodeSet, no ObjectTypes, no VariableTypes, no DataTypes, no ReferenceTypes and no Instances. The NodeClass clauses of OPC 20020 are therefore omitted rather than left empty, and Annex A states the generated per-type reference this document does define in place of a NodeSet."
    }
  ],
  "identity": {
    "docNumber": "OPC nnnnn-m",
    "partNumber": "Part 1",
    "partName": "Arrow Encoding",
