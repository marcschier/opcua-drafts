    "subjectTerm": "Arrow",
    "mainTitle": "OPC UA FOR APACHE ARROW ENCODING",
    "subTitle": "Part 1: Columnar DataEncoding, PubSub batches and historian access",
    "shortName": "ARROW",
    "capabilityIdentifier": "ARROW",
    "namespaceUri": "http://opcfoundation.org/UA/",
    "namespaceIndexInDocument": 0,
    "annexASubject": "DataEncoding",
    "version": "0.1.0",
    "publicationDate": "2026-07-30",
    "releaseType": "Draft",
